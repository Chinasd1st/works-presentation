---
// Work card used on the homepage and the works index.
// 作品卡片（首页/作品列表复用）。
import type { CollectionEntry } from 'astro:content';
import { assetUrl } from '../lib/assetUrl';

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, category, date, cover, location } = work.data;
const year = date.getFullYear();
---

<a
  class="work-card"
  data-cat={category}
  href={`${import.meta.env.BASE_URL}works/${work.id}/`}
>
  <div class="thumb">
    <img src={assetUrl(cover)} alt={title} loading="lazy" />
  </div>
  <div class="meta">
    <span class="title">{title}</span>
    <span class="info">
      {category}{location ? ` / ${location}` : ''} · {year}
    </span>
  </div>
</a>
