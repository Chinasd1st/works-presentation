---
// Work card used on the homepage and the works index.
// 作品卡片（首页/作品列表复用）。
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>;
  /** Eager-load the thumbnail (first above-the-fold card). */
  priority?: boolean;
}

const { work, priority } = Astro.props;
const { title, category, date, cover, location } = work.data;
const year = date.getFullYear();
// Cards render at most ~800px wide; output a 800px webp keeping the ratio.
const cardWidth = 800;
const cardHeight = Math.round((cardWidth * cover.height) / cover.width);
---

<a
  class="work-card"
  data-cat={category}
  href={`${import.meta.env.BASE_URL}works/${work.id}/`}
>
  <div class="thumb">
    <Image
      src={cover}
      alt={title}
      width={cardWidth}
      height={cardHeight}
      format="webp"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </div>
  <div class="meta">
    <span class="title">{title}</span>
    <span class="info">
      {category}{location ? ` / ${location}` : ''} · {year}
    </span>
  </div>
</a>
