---
// Homepage — hero + featured works + latest works.
// 首页 —— 巨幅标题 + 精选作品 + 最新作品。
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../site.config';

const allWorks = await getCollection('works', ({ data }) => data.featured === false);
// sort by date descending, then split featured / rest
const works = (await getCollection('works')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featured = works.filter((w) => w.data.featured).slice(0, 4);
const recent = allWorks.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);
// letter-level spans, like hoshimiyatoto.com (each letter is its own element)
const heroLetters = siteConfig.title
  .toUpperCase()
  .split('')
  .map((ch) => ({ ch, space: ch === ' ' }));
---

<Layout>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Portfolio — {new Date().getFullYear()}</p>
      <h1 class="display hero-title" aria-label={siteConfig.title.toUpperCase()}>
        {
          heroLetters.map(({ ch, space }) =>
            space ? (
              <span class="hero-space" aria-hidden="true" />
            ) : (
              <span class="hero-letter" aria-hidden="true">
                {ch}
              </span>
            ),
          )
        }
      </h1>
      <p class="hero-tagline">{siteConfig.tagline}</p>
    </div>
  </section>

  <section class="section description">
    <div class="container">
      <p class="eyebrow">About</p>
      <p class="description-text">
        Photographer and designer based in China — working across landscape, urban and portrait
        photography, visual identity design and print. Selected works and experiments live below.
      </p>
      <p class="description-text zh">
        摄影师与设计师，常驻中国。作品涵盖风景、城市与人像摄影，视觉识别设计与印刷物。
        精选作品与实验项目陈列于下。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Selected Works</h2>
        <a class="seeall-link" href={`${import.meta.env.BASE_URL}works/`}>ALL →</a>
      </div>
      <div class="grid">
        {featured.map((work) => <WorkCard work={work} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Latest</h2>
        <a class="seeall-link" href={`${import.meta.env.BASE_URL}works/`}>ALL →</a>
      </div>
      <div class="grid">
        {recent.map((work) => <WorkCard work={work} />)}
      </div>
    </div>
  </section>
</Layout>

<noscript>
  <style is:inline>
    .hero-letter {
      opacity: 1;
    }
  </style>
</noscript>

<style>
  .hero {
    padding-block: clamp(64px, 14vh, 160px) var(--space-9);
  }

  .hero-title {
    margin: var(--space-5) 0 var(--space-6);
  }

  .hero-letter {
    display: inline-block;
    /* Hidden until JS swaps in the scramble glyphs, so the plain title
       is never shown before the animation. Restored via reduced-motion.
       动画前隐藏字母：JS 先写入乱码再解码，避免先展示正常标题。 */
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-letter {
      opacity: 1;
    }
  }

  .hero-space {
    display: inline-block;
    width: 0.3em;
  }

  .hero-tagline {
    font-size: clamp(15px, 1.6vw, 19px);
    color: var(--fg-secondary);
    margin: 0;
    max-width: 34ch;
    text-wrap: pretty;
  }

  .description {
    padding-top: var(--space-5);
  }

  .description-text {
    font-size: clamp(22px, 2.8vw, 36px);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--fg-secondary);
    max-width: 30ch;
    margin: var(--space-4) 0 0;
    text-wrap: pretty;
  }

  .description-text.zh {
    max-width: 26ch;
    margin-top: var(--space-5);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: start;
    gap: var(--space-7) var(--space-6);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  /* Pixel-reveal canvas overlaying thumbnails (created at runtime) */

  :global(.px-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
</style>

<script>
  import { animate, scrambleText } from 'animejs';

  // Official anime.js scrambleText entrance: each hero letter starts as
  // random glyphs, then decodes to its real character one by one
  // (typewriter-like, left to right).
  // 官方 scrambleText 入场：每个字母先显示乱码，随后逐字解码为正常字符（打字机效果）。
  //
  // Letters are hidden in CSS until this runs: JS swaps in random glyphs
  // before the animation so the plain title is never shown on first paint.
  // settleDuration stays well below duration (settleRatio << 1): with a
  // single character + perturbation, a settle time past the animation end
  // leaves the letter stuck on a random glyph. Only run via astro:page-load —
  // it also fires on initial load, so calling heroTypo() again would start a
  // second scramble on the same elements and clobber the final value.
  function heroTypo() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const letters = Array.from(document.querySelectorAll<HTMLElement>('.hero-letter'));
    if (letters.length === 0) return;
    const glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&@';
    letters.forEach((el, i) => {
      const target = el.textContent ?? '';
      el.textContent = Array.from(
        { length: target.length },
        () => glyphs[Math.floor(Math.random() * glyphs.length)],
      ).join('');
      el.style.opacity = '1';
      animate(el, {
        innerHTML: scrambleText({
          text: target,
          chars: 'a-zA-Z0-9#%&@',
          from: 'left',
          revealRate: 50,
          settleRate: 30,
          settleDuration: 300,
          perturbation: 0.3,
          duration: 1200,
          delay: i * 70,
        }),
      });
    });
  }

  // Pixelate (crystal) entrance for work card thumbnails: a canvas renders
  // the image as coarse blocks (nearest-neighbour sampling) that refine to
  // full detail as the card scrolls into view, then fades out.
  // 作品卡片晶格化入场：canvas 以近邻采样显示粗块马赛克，进入视口后逐帧细化。
  function pixelReveal(img: HTMLImageElement) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (img.dataset.px) return;
    const start = () => {
      img.dataset.px = '1';
      const w = img.naturalWidth;
      const h = img.naturalHeight;
      if (!w || !h) return;
      const thumb = img.closest<HTMLElement>('.thumb');
      if (!thumb) return;
      const canvas = document.createElement('canvas');
      canvas.className = 'px-canvas';
      canvas.setAttribute('aria-hidden', 'true');
      thumb.style.position = 'relative';
      thumb.appendChild(canvas);

      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const DURATION = 750;
      const MAX_BLOCK = 48;
      const t0 = performance.now();

      const frame = (now: number) => {
        const t = Math.min((now - t0) / DURATION, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        const block = Math.max(1, Math.round(MAX_BLOCK * (1 - eased)));
        canvas.width = Math.max(1, Math.round(w / block));
        canvas.height = Math.max(1, Math.round(h / block));
        ctx.imageSmoothingEnabled = false;
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          canvas.remove();
        }
      };
      requestAnimationFrame(frame);
    };

    if (img.complete && img.naturalWidth > 0) start();
    else img.addEventListener('load', start, { once: true });
  }

  function initReveals() {
    const images = Array.from(document.querySelectorAll<HTMLImageElement>('.work-card .thumb img'));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            pixelReveal(entry.target as HTMLImageElement);
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '160px' },
    );
    images.forEach((img) => io.observe(img));
  }

  // Fires on initial load AND after every navigation (no direct call needed).
  document.addEventListener('astro:page-load', () => {
    heroTypo();
    initReveals();
  });
</script>
