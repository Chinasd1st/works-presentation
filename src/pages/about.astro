---
// About page — bio + contact links.
// 关于页 —— 简介 + 联系方式。
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../site.config';

const links = [
  { label: 'Blog', name: 'silentnrtx.top', href: 'https://silentnrtx.top' },
  {
    label: 'Bilibili',
    name: 'bilibili.com',
    href: 'https://space.bilibili.com/?spm_id_from=333.1007.0.0',
  },
  { label: 'GitHub', name: 'chinasd1st', href: 'https://github.com/chinasd1st' },
  { label: 'Osu', name: 'osu!', href: 'https://osu.ppy.sh/users/34040390' },
];
---

<Layout title="About" description="About the artist — 关于">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">About</p>
      <!-- .h2 keeps the visual weight consistent with section titles
           like "Selected Works" on the homepage. -->
      <h1 class="h2">{siteConfig.title}</h1>

      <div class="stack bio">
        <p>
          Working across landscape, urban and portrait photography, and visual identity design.
        </p>
      </div>

      <h2 class="contact-head">Contact</h2>
      <ul class="links">
        {links.map((link) => (
          <li>
            <span class="link-label">{link.label}</span>
            <a class="link-value" href={link.href} target="_blank" rel="noopener noreferrer">
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .narrow {
    max-width: 640px;
  }

  .bio {
    margin-top: var(--space-6);
    font-size: 17px;
    color: var(--fg-secondary);
    text-wrap: pretty;
  }

  .contact-head {
    margin-top: var(--space-8);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }

  .links {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .links li {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .link-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
    min-width: 72px;
  }

  .link-value {
    font-size: 17px;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .link-value:hover {
    color: var(--fg-secondary);
    border-color: var(--fg-secondary);
  }
</style>
