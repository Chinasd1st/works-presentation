---
// Work detail page — large cover + metadata + markdown body.
// 作品详情页 —— 大图 + 元信息 + Markdown 正文。
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { assetUrl } from '../../lib/assetUrl';
import { rehypeAssetBase } from '../../lib/rehypeAssetBase';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

interface Props {
  work: Awaited<ReturnType<typeof getCollection>>[number];
}

const { work } = Astro.props;
const { title, category, date, cover, tags, location, description } = work.data;
const { Content } = await render(work, { rehypePlugins: [rehypeAssetBase] });

const year = date.getFullYear();
const dateLabel = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={title} description={description}>
  <article class="section work-detail">
    <div class="container">
      <figure class="cover">
        <img src={assetUrl(cover)} alt={title} />
        <figcaption class="work-head">
          <p class="eyebrow">
            {category}{location ? ` / ${location}` : ''} · {year}
          </p>
          <h1 class="h1 work-title">{title}</h1>
          <p class="work-date faint">{dateLabel}</p>
        </figcaption>
      </figure>

      <div class="work-body stack">
        <h2 class="work-section-title">About this work</h2>
        <Content />
      </div>

      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }

      <nav class="work-nav" aria-label="Works navigation">
        <a class="seeall-link" href={`${import.meta.env.BASE_URL}works/`}>← ALL WORKS</a>
      </nav>
    </div>
  </article>
</Layout>

<script>
  // Pixelate (crystal) entrance: a canvas shows the image as coarse blocks
  // (nearest-neighbour sampling) that refine to full detail, then fades out.
  // 晶格化入场：canvas 以近邻采样显示粗块马赛克，逐帧细化到正常后移除。
  function pixelReveal(img: HTMLImageElement) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (img.dataset.px) return;
    const start = () => {
      img.dataset.px = '1';
      const w = img.naturalWidth;
      const h = img.naturalHeight;
      if (!w || !h) return;

      const canvas = document.createElement('canvas');
      canvas.className = 'px-canvas';
      canvas.setAttribute('aria-hidden', 'true');
      const host = img.closest('.cover') ?? img.parentElement;
      if (host) {
        (host as HTMLElement).style.position = 'relative';
        host.appendChild(canvas);
      }

      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const DURATION = 750;
      const MAX_BLOCK = 48;
      const t0 = performance.now();

      const frame = (now: number) => {
        const t = Math.min((now - t0) / DURATION, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        const block = Math.max(1, Math.round(MAX_BLOCK * (1 - eased)));
        canvas.width = Math.max(1, Math.round(w / block));
        canvas.height = Math.max(1, Math.round(h / block));
        ctx.imageSmoothingEnabled = false;
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          canvas.remove();
        }
      };
      requestAnimationFrame(frame);
    };

    if (img.complete && img.naturalWidth > 0) start();
    else img.addEventListener('load', start, { once: true });
  }

  // Lightbox for body images — click to view fullscreen, click or Esc to close.
  // 正文图片灯箱：点击全屏查看，点击/Esc 关闭。
  function initLightbox() {
    document.querySelectorAll<HTMLImageElement>('.work-body img').forEach((img) => {
      if (img.dataset.lightbox) return;
      img.dataset.lightbox = 'true';
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', () => {
        const overlay = document.createElement('div');
        overlay.className = 'lightbox';
        const full = document.createElement('img');
        full.src = img.src;
        full.alt = img.alt;
        overlay.appendChild(full);
        document.body.appendChild(overlay);
        document.body.style.overflow = 'hidden';

        const close = () => {
          overlay.remove();
          document.body.style.overflow = '';
          document.removeEventListener('keydown', onKey);
        };
        const onKey = (e: KeyboardEvent) => {
          if (e.key === 'Escape') close();
        };
        overlay.addEventListener('click', close);
        document.addEventListener('keydown', onKey);
      });
    });
  }

  function initReveals() {
    document.querySelectorAll<HTMLImageElement>('.cover img, .work-body img').forEach((img) => {
      pixelReveal(img);
    });
  }

  initLightbox();
  initReveals();
  document.addEventListener('astro:page-load', () => {
    initLightbox();
    initReveals();
  });
</script>

<style>
  .work-detail {
    padding-top: var(--space-8);
  }

  .work-head {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    padding: var(--space-5) var(--space-6);
  }

  .work-title {
    margin-bottom: var(--space-2);
  }

  .work-date {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cover {
    position: relative;
    margin: 0 0 var(--space-8);
    aspect-ratio: 3 / 1;
    overflow: hidden;
    background: var(--bg-muted);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Theme-colored solid scrim: uniform tint that keeps the overlaid
     title readable in both light and dark themes.
     主题色纯色遮罩：均匀着色，保证标题在深浅主题下均可读。 */
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
  }

  /* Overlaid info uses pure foreground (black/white), no gray tones */
  .cover .eyebrow,
  .cover .work-date {
    color: var(--fg);
  }

  @media (max-width: 650px) {
    .cover {
      aspect-ratio: 16 / 9;
    }
  }

  .work-body {
    max-width: 68ch;
    margin-inline: auto;
    color: var(--fg-secondary);
    font-size: 17px;
  }

  .work-section-title {
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    padding-top: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .work-body :global(h2) {
    color: var(--fg);
    font-size: 22px;
    margin-top: var(--space-6);
  }

  .work-body :global(p) {
    margin: 0;
    text-wrap: pretty;
  }

  .work-body :global(figure) {
    margin: var(--space-6) 0;
  }

  .work-body :global(figcaption) {
    font-size: 13px;
    color: var(--fg-faint);
    margin-top: var(--space-2);
  }

  .work-body :global(img) {
    display: block;
    margin: var(--space-6) auto;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-8) 0 0;
  }

  .tags li {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-secondary);
    padding: 2px var(--space-2);
  }

  .work-nav {
    margin-top: var(--space-9);
    padding-top: var(--space-4);
  }

  /* Lightbox overlay (created at runtime, so styles must be :global) */

  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.92);
    cursor: zoom-out;
    animation: lightbox-fade var(--dur) var(--ease);
  }

  :global(.lightbox img) {
    max-width: 92vw;
    max-height: 92vh;
    object-fit: contain;
    border: none;
  }

  /* Pixel-reveal canvas overlaying the image (created at runtime) */

  :global(.px-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  @keyframes lightbox-fade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>
