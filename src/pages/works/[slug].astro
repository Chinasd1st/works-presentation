---
// Work detail page — large cover + metadata + markdown body.
// 作品详情页 —— 大图 + 元信息 + Markdown 正文。
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { assetUrl } from '../../lib/assetUrl';
import { rehypeAssetBase } from '../../lib/rehypeAssetBase';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

interface Props {
  work: Awaited<ReturnType<typeof getCollection>>[number];
}

const { work } = Astro.props;
const { title, category, date, cover, tags, location, description } = work.data;
const { Content } = await render(work, { rehypePlugins: [rehypeAssetBase] });

const year = date.getFullYear();
const dateLabel = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={title} description={description}>
  <article class="section work-detail">
    <div class="container">
      <figure class="cover">
        <img src={assetUrl(cover)} alt={title} />
        <figcaption class="work-head">
          <p class="eyebrow">
            {category}{location ? ` / ${location}` : ''} · {year}
          </p>
          <h1 class="h1 work-title">{title}</h1>
          <p class="work-date faint">{dateLabel}</p>
        </figcaption>
      </figure>

      <div class="work-body stack">
        <h2 class="work-section-title">About this work</h2>
        <Content />
      </div>

      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }

      <nav class="work-nav" aria-label="Works navigation">
        <a class="seeall-link" href={`${import.meta.env.BASE_URL}works/`}>← ALL WORKS</a>
      </nav>
    </div>
  </article>
</Layout>

<script>
  // Lightbox for body images — click to view fullscreen, click or Esc to close.
  // A circular zoom lens follows the pointer over the image.
  // 正文图片灯箱：点击全屏查看，点击/Esc 关闭；圆形放大镜跟随鼠标。
  function initLightbox() {
    document.querySelectorAll<HTMLImageElement>('.work-body img').forEach((img) => {
      if (img.dataset.lightbox) return;
      img.dataset.lightbox = 'true';
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', () => {
        const overlay = document.createElement('div');
        overlay.className = 'lightbox';
        const full = document.createElement('img');
        full.src = img.src;
        full.alt = img.alt;
        overlay.appendChild(full);

        // Zoom lens: magnified view following the pointer.
        // 放大镜：2x 放大视图，跟随鼠标，离开图片区域隐藏。
        const ZOOM = 2;
        const SIZE = 200;
        const lens = document.createElement('div');
        lens.className = 'zoom-lens';
        const lensImg = document.createElement('img');
        lensImg.alt = '';
        lensImg.draggable = false;
        lens.appendChild(lensImg);
        overlay.appendChild(lens);
        document.body.appendChild(overlay);
        document.body.classList.add('lightbox-open');
        document.body.style.overflow = 'hidden';

        const updateLens = (e: MouseEvent) => {
          const r = full.getBoundingClientRect();
          const x = e.clientX - r.left;
          const y = e.clientY - r.top;
          const inside = x >= 0 && y >= 0 && x <= r.width && y <= r.height;
          if (!inside || r.width === 0 || r.height === 0) {
            lens.classList.remove('on');
            return;
          }
          lens.classList.add('on');
          lensImg.style.width = `${r.width * ZOOM}px`;
          lensImg.style.height = `${r.height * ZOOM}px`;
          lensImg.style.transform = `translate(${-x * ZOOM + SIZE / 2}px, ${-y * ZOOM + SIZE / 2}px)`;
          lens.style.left = `${e.clientX - SIZE / 2}px`;
          lens.style.top = `${e.clientY - SIZE / 2}px`;
        };
        overlay.addEventListener('mousemove', updateLens);

        const close = () => {
          overlay.remove();
          document.body.classList.remove('lightbox-open');
          document.body.style.overflow = '';
          document.removeEventListener('keydown', onKey);
        };
        const onKey = (e: KeyboardEvent) => {
          if (e.key === 'Escape') close();
        };
        overlay.addEventListener('click', close);
        document.addEventListener('keydown', onKey);
      });
    });
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>

<style>
  .work-detail {
    padding-top: var(--space-8);
  }

  .work-head {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    padding: var(--space-5) var(--space-6);
  }

  .work-title {
    margin-bottom: var(--space-2);
  }

  .work-date {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cover {
    position: relative;
    margin: 0 0 var(--space-8);
    aspect-ratio: 3 / 1;
    overflow: hidden;
    background: var(--bg-muted);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Theme-colored solid scrim: uniform tint that keeps the overlaid
     title readable in both light and dark themes.
     主题色纯色遮罩：均匀着色，保证标题在深浅主题下均可读。 */
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
  }

  /* Overlaid info uses pure foreground (black/white), no gray tones */
  .cover .eyebrow,
  .cover .work-date {
    color: var(--fg);
  }

  @media (max-width: 650px) {
    .cover {
      aspect-ratio: 16 / 9;
    }
  }

  .work-body {
    max-width: 68ch;
    margin-inline: auto;
    color: var(--fg-secondary);
    font-size: 17px;
  }

  .work-section-title {
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    padding-top: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .work-body :global(h2) {
    color: var(--fg);
    font-size: 22px;
    margin-top: var(--space-6);
  }

  .work-body :global(p) {
    margin: 0;
    text-wrap: pretty;
  }

  .work-body :global(figure) {
    margin: var(--space-6) 0;
  }

  .work-body :global(figcaption) {
    font-size: 13px;
    color: var(--fg-faint);
    margin-top: var(--space-2);
  }

  .work-body :global(img) {
    display: block;
    margin: var(--space-6) auto;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-8) 0 0;
  }

  .tags li {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-secondary);
    padding: 2px var(--space-2);
  }

  .work-nav {
    margin-top: var(--space-9);
    padding-top: var(--space-4);
  }

  /* Lightbox overlay (created at runtime, so styles must be :global) */

  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.92);
    cursor: zoom-out;
    animation: lightbox-fade var(--dur) var(--ease);
  }

  :global(.lightbox img) {
    max-width: 92vw;
    max-height: 92vh;
    object-fit: contain;
    border: none;
  }

  /* Zoom lens (created at runtime) — circular magnifier over the pointer */
  :global(.zoom-lens) {
    position: fixed;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 3px solid var(--fg);
    background: var(--bg);
    overflow: hidden;
    pointer-events: none;
    z-index: 110;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }

  :global(.zoom-lens.on) {
    opacity: 1;
  }

  :global(.zoom-lens img) {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
    display: block;
    will-change: transform;
  }

  /* Crosshair center, accent colored — 中心十字准星（accent 色） */
  :global(.zoom-lens)::before,
  :global(.zoom-lens)::after {
    content: '';
    position: absolute;
    background: var(--accent);
    z-index: 1;
  }

  :global(.zoom-lens)::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    transform: translateY(-0.75px);
  }

  :global(.zoom-lens)::after {
    left: 50%;
    top: 0;
    height: 100%;
    width: 1.5px;
    transform: translateX(-0.75px);
  }

  @keyframes lightbox-fade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>
