---
// Core layout: fonts, theme bootstrapping, SEO, header, footer.
// 核心布局：字体、主题初始化、SEO、页头页脚。
import '@fontsource-variable/geist';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { siBilibili, siGithub, siOsu, siRss } from 'simple-icons';
import { siteConfig } from '../site.config';
import Cursor from '../components/Cursor.astro';

// Brand icons (simple-icons) per social label. Official brand marks:
// Bilibili and GitHub have real icons here, unlike Lucide.
const socialIcons: Record<string, string> = {
  Blog: siRss.path,
  Bilibili: siBilibili.path,
  GitHub: siGithub.path,
  Osu: siOsu.path,
};

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.title}` : siteConfig.title;
const pageDescription = description ?? siteConfig.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <!-- Theme bootstrap + toggle handler.
         Must be is:inline + global function: View Transitions replaces the DOM
         on navigation, so event listeners attached to elements are lost.
         必须用内联脚本 + 全局函数：View Transitions 导航会替换 DOM，
         绑定在元素上的监听器会丢失。 -->
    <script is:inline>
      (() => {
        function applyTheme() {
          const stored = localStorage.getItem('theme');
          const theme =
            stored || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        }

        // Initial load
        applyTheme();

        // Re-apply after View Transitions swap
        document.addEventListener('astro:after-swap', applyTheme);

        window.toggleTheme = () => {
          const html = document.documentElement;
          const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
          html.dataset.theme = next;
          localStorage.setItem('theme', next);
        };
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <aside class="sidebar">
      <a class="brand" href={import.meta.env.BASE_URL}>
        {siteConfig.title}
      </a>
      <nav class="nav" aria-label="Main">
        {siteConfig.nav.map((item) => (
          <a href={`${import.meta.env.BASE_URL}${item.href.replace(/^\//, '')}`}>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="sidebar-foot">
        <button
          class="theme-toggle"
          id="theme-toggle"
          type="button"
          aria-label="Toggle color theme"
          onclick="toggleTheme()"
        >
          Theme
        </button>
      </div>
    </aside>

    <div class="page">
      <main id="main">
        <slot />
      </main>

      <footer>
        <div class="container footer-inner">
          <span>&copy; {new Date().getFullYear()} {siteConfig.copyright}</span>
          <nav class="social" aria-label="Social links">
            {siteConfig.social.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                <svg
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={socialIcons[s.label]} />
                </svg>
              </a>
            ))}
          </nav>
          <span class="faint">Photography &amp; Design</span>
        </div>
      </footer>
    </div>

    <Cursor />
  </body>
</html>

<style>
  /* ---------- Sidebar (fixed left rail, hoshimiyatoto-style) ---------- */

  .sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-7);
    padding: var(--space-6) clamp(20px, 2.4vw, 40px);
    box-sizing: border-box;
  }

  .brand {
    font-weight: 600;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .nav a {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    /* Pure foreground (black in light theme, #ededed in dark) — 纯前景色 */
    color: var(--fg);
    transition:
      opacity var(--dur-fast) var(--ease),
      letter-spacing var(--dur-fast) var(--ease);
  }

  .nav a:hover {
    opacity: 0.6;
    letter-spacing: 0.16em;
  }

  .sidebar-foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .theme-toggle {
    text-align: left;
  }

  .page {
    min-width: 0;
  }

  /* ---------- Footer ---------- */

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .social {
    display: flex;
    gap: var(--space-4);
  }

  .social a {
    display: inline-flex;
    color: var(--fg-secondary);
    transition: color var(--dur-fast) var(--ease);
  }

  .social a:hover {
    color: var(--fg);
  }

  @media (max-width: 900px) {
    /* Sidebar collapses into a top bar on small screens.
       移动端侧栏折叠为顶部横排。 */
    .sidebar {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-4) clamp(20px, 4vw, 40px);
    }

    .sidebar-foot {
      display: none;
    }

    .nav {
      flex-direction: row;
      gap: var(--space-4);
    }

    .nav a {
      font-size: 12px;
    }
  }
</style>
